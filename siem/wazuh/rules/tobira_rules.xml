<!--
  Tobira rules for Wazuh.

  These mirror src/tobira/siem/rules/tobira-access.yml one-for-one, so a finding
  in the lab report and a finding in a production Wazuh deployment carry the
  same identifier and the same meaning.

  Install:
    cp tobira_rules.xml /var/ossec/etc/rules/
    chown root:wazuh /var/ossec/etc/rules/tobira_rules.xml
    /var/ossec/bin/wazuh-control restart

  Rule id range 100100-100199 is reserved here for Tobira.
-->
<group name="tobira,zero_trust,">

  <!-- Base rule: anything from the Tobira access dataset. -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="event.module">^tobira$</field>
    <description>Tobira zero trust broker event</description>
    <options>no_full_log</options>
  </rule>

  <!-- TOB-001 -->
  <rule id="100101" level="14">
    <if_sid>100100</if_sid>
    <field name="event.action">^authentication_failed$</field>
    <field name="event.reason">^token_device_mismatch$</field>
    <description>Tobira: access token replayed from a different device ($(user.name))</description>
    <mitre>
      <id>T1550.001</id>
      <id>T1539</id>
    </mitre>
    <group>authentication_failed,credential_access,</group>
  </rule>

  <!-- TOB-002 -->
  <rule id="100102" level="14">
    <if_sid>100100</if_sid>
    <field name="event.action">^connector_registration_denied$</field>
    <description>Tobira: App Connector $(tobira.connector) tried to publish applications it does not own</description>
    <mitre>
      <id>T1557</id>
      <id>T1199</id>
    </mitre>
    <group>policy_violation,</group>
  </rule>

  <!-- TOB-003: application enumeration (frequency over distinct apps) -->
  <rule id="100103" level="5">
    <if_sid>100100</if_sid>
    <field name="event.action">^access_denied$</field>
    <description>Tobira: access denied for $(user.name) to $(tobira.app) - $(event.reason)</description>
    <group>access_denied,</group>
  </rule>

  <rule id="100104" level="12" frequency="3" timeframe="120">
    <if_matched_sid>100103</if_matched_sid>
    <same_field>user.name</same_field>
    <different_field>tobira.app</different_field>
    <description>Tobira: private application enumeration by $(user.name)</description>
    <mitre>
      <id>T1046</id>
      <id>T1087</id>
    </mitre>
    <group>recon,</group>
  </rule>

  <!-- TOB-004 -->
  <rule id="100105" level="8" frequency="5" timeframe="120">
    <if_matched_sid>100103</if_matched_sid>
    <same_field>user.name</same_field>
    <description>Tobira: repeated access denials for $(user.name)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- TOB-005 -->
  <rule id="100106" level="12">
    <if_sid>100100</if_sid>
    <field name="event.action">^authentication_failed$</field>
    <field name="event.reason">^posture_</field>
    <description>Tobira: device posture attestation forged, stale or replayed ($(tobira.device_id))</description>
    <mitre>
      <id>T1036</id>
    </mitre>
    <group>policy_violation,</group>
  </rule>

  <!-- TOB-006 -->
  <rule id="100107" level="12">
    <if_sid>100100</if_sid>
    <field name="event.action">^authentication_failed$</field>
    <field name="event.reason">^token_(revoked|bad_signature|wrong_issuer|wrong_audience|not_device_bound|invalid)$</field>
    <description>Tobira: revoked or invalid credential presented by $(user.name)</description>
    <mitre>
      <id>T1078</id>
      <id>T1606</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <!-- TOB-007 -->
  <rule id="100108" level="12">
    <if_sid>100100</if_sid>
    <field name="event.action">^tunnel_rejected$</field>
    <description>Tobira: tunnel rejected at the TLS or role boundary - $(event.reason)</description>
    <mitre>
      <id>T1190</id>
      <id>T1199</id>
    </mitre>
  </rule>

  <!-- TOB-008 -->
  <rule id="100109" level="12">
    <if_sid>100100</if_sid>
    <field name="event.action">^access_revoked$</field>
    <description>Tobira: live session revoked after device posture dropped ($(tobira.device_id))</description>
    <mitre>
      <id>T1562.004</id>
    </mitre>
  </rule>

  <!-- TOB-009 -->
  <rule id="100110" level="12">
    <if_sid>100100</if_sid>
    <field name="event.action">^session_terminated$</field>
    <description>Tobira: session terminated by the broker - $(event.reason)</description>
    <mitre>
      <id>T1562</id>
    </mitre>
  </rule>

  <!-- TOB-010 -->
  <rule id="100111" level="7">
    <if_sid>100103</if_sid>
    <field name="event.reason">^outside_time_window$</field>
    <description>Tobira: $(user.name) denied $(tobira.app) outside the permitted time window</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- TOB-011 -->
  <rule id="100112" level="4">
    <if_sid>100103</if_sid>
    <field name="event.reason">^posture_failed$</field>
    <description>Tobira: $(user.name) denied $(tobira.app) - device posture below policy</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
  </rule>

  <!-- TOB-012: audit visibility, not an attack -->
  <rule id="100113" level="3">
    <if_sid>100100</if_sid>
    <field name="event.action">^access_granted$</field>
    <field name="tobira.app">^factory-hmi$</field>
    <description>Tobira: $(user.name) was granted access to critical application $(tobira.app)</description>
    <group>audit,</group>
  </rule>

</group>
